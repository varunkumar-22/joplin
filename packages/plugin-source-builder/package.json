{
	"name": "@joplin/plugin-source-builder",
	"version": "1.0.0",
	"description": "Builds Joplin plugins from reviewed source instead of pulling pre-built npm packages",
	"main": "index.js",
	"scripts": {
		"tsc": "tsc --project tsconfig.json",
		"watch": "tsc --watch --preserveWatchOutput --project tsconfig.json",
		"test": "jest",
		"test-ci": "yarn test",
		"start": "node index.js"
	},
	"author": "sriramvarunkumar",
	"license": "AGPL-3.0-or-later",
	"dependencies": {
		"fs-extra": "11.3.2",
		"source-map-support": "0.5.21",
		"yargs": "17.7.2"
	},
	"devDependencies": {
		"@types/fs-extra": "11.0.4",
		"@types/jest": "29.5.14",
		"@types/node": "18.19.130",
		"@types/yargs": "17.0.33",
		"jest": "29.7.0",
		"typescript": "5.8.3"
	}
}
